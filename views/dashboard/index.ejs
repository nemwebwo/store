
<%- include('../partials/header') %>

<main class="max-w-6xl mx-auto p-6">

  <div class="mb-6">
    <h2 class="text-2xl font-bold">Dashboard</h2>
    <p class="text-slate-500">
      ภาพรวมระบบจัดการสินค้า
    </p>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

    <div class="bg-white p-6 rounded-xl shadow-sm">
      <p class="text-slate-500">รายการสินค้าทั้งหมด</p>
      <h3 class="text-3xl font-bold mt-2">
        <%= stats.totalProducts.toLocaleString('th-TH') %>
      </h3>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm">
      <p class="text-slate-500">จำนวนสินค้าคงเหลือ</p>
      <h3 class="text-3xl font-bold mt-2">
        <%= stats.stockQuantity.toLocaleString('th-TH') %>
      </h3>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm">
      <p class="text-slate-500">ยอดนำเข้าทั้งหมด</p>
      <h3 class="text-3xl font-bold text-green-600 mt-2">
        <%= stats.stockIn.toLocaleString('th-TH') %>
      </h3>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm">
      <p class="text-slate-500">ยอดส่งออกทั้งหมด</p>
      <h3 class="text-3xl font-bold text-orange-600 mt-2">
        <%= stats.stockOut.toLocaleString('th-TH') %>
      </h3>
    </div>

  </div>

  <!-- Recent Movements -->
  <div class="bg-white rounded-xl shadow-sm mt-8 overflow-hidden">

    <div class="p-6 border-b border-slate-200">
      <h3 class="text-lg font-semibold">
        ประวัติการเคลื่อนไหวล่าสุด
      </h3>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">

        <thead class="bg-slate-50 text-slate-600">
          <tr>
            <th class="p-4">วันที่</th>
            <th class="p-4">รหัสสินค้า</th>
            <th class="p-4">ชื่อสินค้า</th>
            <th class="p-4">ประเภท</th>
            <th class="p-4">จำนวน</th>
            <th class="p-4">ผู้ทำรายการ</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">

          <% if (recentMovements.length === 0) { %>

            <tr>
              <td colspan="6"
                  class="p-8 text-center text-slate-500">
                ยังไม่มีรายการนำเข้าหรือส่งออก
              </td>
            </tr>

          <% } else { %>

            <% recentMovements.forEach(item => { %>
              <tr class="hover:bg-slate-50">

                <td class="p-4">
                  <%= new Date(item.created_at)
                    .toLocaleString('th-TH') %>
                </td>

                <td class="p-4">
                  <%= item.product_code %>
                </td>

                <td class="p-4">
                  <%= item.product_name %>
                </td>

                <td class="p-4">
                  <% if (item.type === 'IN') { %>
                    <span class="text-green-600 font-medium">
                      นำเข้า
                    </span>
                  <% } else { %>
                    <span class="text-orange-600 font-medium">
                      ส่งออก
                    </span>
                  <% } %>
                </td>

                <td class="p-4">
                  <%= Number(item.quantity).toLocaleString('th-TH') %>
                </td>

                <td class="p-4">
                  <%= item.username %>
                </td>

              </tr>
            <% }) %>

          <% } %>

        </tbody>
      </table>
    </div>

  </div>

</main>

<%- include('../partials/footer') %>
